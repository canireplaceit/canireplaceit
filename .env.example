# canireplaceit — the one configuration file.
#
#   bun run env:gen          # writes .env with the three secrets already made
#   cp .env.example .env     # or fill it in by hand
#
# Read only by apps/backend/src/env.ts. Every value here is a placeholder — the
# real .env is gitignored and never committed.
#
# The rule throughout: AN UNSET VARIABLE MEANS THE FEATURE IS OFF, never a
# guessed default. Only durations, caps and TTLs carry defaults, because "off"
# is not a meaningful answer for a timeout. The boot log prints exactly which
# features are live, so a half-configured deploy shows up in the first two lines
# rather than in a support email:
#
#   docker logs canireplaceit-be | head -4

# ─── Origins ──────────────────────────────────────────────────────────────────

# Where the browser is. Every magic link and Stripe return URL is built against
# the FIRST entry. Comma-separate if more than one host must pass CORS.
# PRODUCTION REFUSES TO BOOT if this is unset or still points at localhost.
WEB_ORIGIN=https://example.com

# Where the API is reachable FROM A BROWSER. In production the edge nginx proxies
# /api on the same origin, so leave it unset and it follows WEB_ORIGIN. In
# development they are two different ports and this needs its own value, or a
# magic link lands on the SPA and silently signs nobody in.
# API_ORIGIN=http://localhost:3001

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Each one: openssl rand -hex 32       (or just run `bun run env:gen`)

# Signs the session cookie. Unset disables sign-in entirely — and with it the
# admin console. Rotating it logs everybody out.
AUTH_SECRET=

# Signs the voter cookie and the network hashes. A fresh clone falls back to the
# published default `dev-secret-change-me`, and PRODUCTION REFUSES TO BOOT on
# it: anyone who has read this repo could otherwise mint identities and forge
# the vote counts the site sells itself on. Rotating it resets every voter.
VOTE_SECRET=

# Bearer for /api/admin/* — the machine path, for scripts. Unset leaves those
# routes answering 503. Independent of SITE_ADMIN below.
ADMIN_TOKEN=

# Who may approve ads, issue refunds, and see every campaign. Comma-separated.
# Signing in with one of these grants the /admin console — there is no seeded
# account and no password. Empty means nobody, never everybody.
SITE_ADMIN=you@example.com

# Optional invisible human check on votes. Unset scores a vote "not checked" —
# a small trust penalty — rather than "failed", so forgetting it cannot quietly
# zero every vote on the site.
TURNSTILE_SECRET=

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Sign-in links and review-outcome mail. Unset means no SMTP and links print to
# stdout — workable for a first login via `docker logs`, not for buyers.
# Only SMTP_HOST is required: mailpit needs no credentials, Gmail needs all
# three, so the host is what decides whether mail is on at all.

# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASS=
# 465 is implicit TLS, 587 is STARTTLS. SMTP_SECURE follows the port when unset
# and rarely needs setting.
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_POOL_MAX=2

# Some providers rewrite a From they do not own — leave this unset there and the
# authenticated user is used instead.
# MAIL_FROM=canireplaceit <noreply@example.com>

# Route all mail to a local mailpit on :1025 while real SMTP_* stay set.
# Opt-in AND ignored under NODE_ENV=production.
# MAIL_DEV_SINK=true

# ─── Payments ─────────────────────────────────────────────────────────────────
# Unset means checkout answers 503. There is deliberately no "default to fake in
# development": an endpoint that hands out paid ad placements for free is a
# vulnerability, not a convenience.
#
#   stripe   real money
#   fake     COMPLETES PURCHASES WITHOUT CHARGING ANYBODY. Ignored entirely
#            under NODE_ENV=production, banner-logged, and stamped on the row as
#            provider="fake-dev" so a database that once ran it can never be
#            mistaken for one that took real money.
PAYMENTS_PROVIDER=

# Both keys are required together or checkout stays off: without the webhook
# secret nothing can flip a purchase to paid, so a sale would take the money and
# never deliver the slot.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_CURRENCY=eur
# Stripe's code for "Website Advertising". Change only on an accountant's call.
# STRIPE_TAX_CODE=txcd_10701000

# ─── Analytics ────────────────────────────────────────────────────────────────
# Self-hosted Umami, read server-side for the public /stats page. All four are
# required together — a URL with no credentials cannot read anything, so
# half-configured means off rather than a stream of 401s in the log.
#
# Use a VIEW-ONLY Umami account: this credential should grant nothing worth
# stealing. There is deliberately no default URL — pointing at somebody else's
# analytics by accident is worse than having none.

# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_USERNAME=
# UMAMI_PASSWORD=
# UMAMI_STATS_TTL_MS=300000
# UMAMI_STATS_WINDOW_DAYS=30
# UMAMI_TIMEOUT_MS=8000

# ─── Sessions and limits ──────────────────────────────────────────────────────

# How long a sign-in link stays valid.
# MAGIC_LINK_TTL_MS=900000
# Session lifetime, renewed on activity. Short on purpose: the token is
# stateless and cannot be revoked, so an idle hour is the whole exposure of a
# stolen cookie.
# SESSION_TTL_MS=3600000
# Sign-in links one address may request per hour.
# MAGIC_LINKS_PER_HOUR=3
# Members one advertiser may invite into their org.
# ORG_MAX_MEMBERS=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# pino level. Defaults to "debug" in development, "info" in production.
# LOG_LEVEL=info

# ─── Development only ─────────────────────────────────────────────────────────

# Seeds demo products, votes and sponsors. Opt-in AND ignored under
# NODE_ENV=production: the fixtures include live sponsor rows nobody paid for,
# and one forgotten variable must not be enough to give inventory away.
# SEED_DEV=true

# Nightly regeneration of the static site from inside the API container.
# REBUILD_ENABLED=false
# REBUILD_INTERVAL_MS=86400000

# Where the product JSON lives. Unset means the repo's own data/.
# CONTENT_DIR=

# ─── Set by compose, not here ─────────────────────────────────────────────────
# NODE_ENV, PORT and DATABASE_URL come from compose.prod.yml. NODE_ENV in
# particular is what makes the fake payment provider, the dev seed and the mail
# sink inert — three fences resting on one value, so it is not left to a file
# anybody might edit.

# ─── Build-time, not runtime ──────────────────────────────────────────────────
# Passed to ./scripts/build-images.sh, not read from this file. They are baked
# into the image: prerender writes SITE_URL into every canonical link and all 18
# sitemap shards, and rsbuild inlines PUBLIC_* into the bundle.
#
#   SITE_URL=https://example.com     required; refused a default
#   PUBLIC_API_URL=                  empty = same origin as the site
#   PUBLIC_UMAMI_WEBSITE_ID=         unset = no tracker script emitted at all
#   PUBLIC_UMAMI_SRC=/u/script.js    where nginx proxies the Umami script
