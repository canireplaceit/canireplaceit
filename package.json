{
	"name": "canireplaceit",
	"private": true,
	"version": "0.0.0",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"env:gen": "bun scripts/gen-env.ts",
		"validate": "bun scripts/validate-content.ts",
		"import": "bun scripts/import-entries.ts",
		"dev": "docker compose up -d --wait && bun --filter backend db:push && turbo run dev",
		"dev:rm": "bun scripts/dev-rm.ts",
		"dev:mail": "docker compose up -d --wait canireplaceit-mail && echo 'mailpit → http://localhost:8025'",
		"build": "turbo run build && bun scripts/prerender.ts",
		"check": "turbo run check",
		"typecheck": "turbo run typecheck",
		"db:generate": "turbo run db:generate --filter=backend",
		"db:push": "turbo run db:push --filter=backend",
		"db:seed": "turbo run db:seed --filter=backend",
		"icons": "bun scripts/fetch-icons.ts",
		"health": "bun scripts/fetch-health.ts",
		"test": "bun test",
		"prerender": "bun scripts/prerender.ts",
		"db:reset": "rm -f data/canireplaceit.db data/canireplaceit.db-wal data/canireplaceit.db-shm && bun --filter backend db:push",
		"hooks": "lefthook install",
		"deploy": "bash scripts/deploy.sh",
		"dev:umami": "docker compose up -d --wait canireplaceit-umami && echo 'umami → http://localhost:3002  (admin/umami)'"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@types/bun": "^1.3.14",
		"core": "workspace:*",
		"lefthook": "^1.10.10",
		"sharp": "^0.35.3",
		"turbo": "^2.10.7",
		"typescript": "^7.0.2"
	}
}
