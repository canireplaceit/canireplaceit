{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"SITE_URL",
		"DATABASE_URL"
	],
	"globalPassThroughEnv": [
		"GITHUB_TOKEN",
		"GITLAB_TOKEN",
		"REFRESH",
		"ONLY",
		"WAIT_FOR_BUDGET",
		"SITE_DOMAIN",
		"INDEXNOW_ENABLED"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"PUBLIC_API_URL",
				"PUBLIC_UMAMI_WEBSITE_ID",
				"PUBLIC_UMAMI_SRC",
				"PUBLIC_TURNSTILE_SITE_KEY",
				"NODE_ENV"
			]
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**",
				"build/**"
			],
			"env": [
				"PUBLIC_API_URL",
				"PUBLIC_UMAMI_WEBSITE_ID",
				"PUBLIC_UMAMI_SRC",
				"PUBLIC_TURNSTILE_SITE_KEY",
				"NODE_ENV"
			]
		},
		"check": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": [
				"^build"
			]
		},
		"db:generate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		}
	}
}
